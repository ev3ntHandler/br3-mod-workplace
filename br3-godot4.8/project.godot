; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Burnin' Rubber 3 (Godot 4.8 Recreation)"
config/description="A Godot 4.8 recreation of Burnin' Rubber 3 by Xform Games, using the original game assets."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.8", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

AudioManager="*res://scripts/audio_manager.gd"
GameData="*res://scripts/game_data.gd"
MainManager="*res://scripts/main_manager.gd"

[global_classes]

AudioManager="res://scripts/audio_manager.gd"
Car="res://scripts/car.gd"
Race="res://scripts/race.gd"
UIManager="res://scripts/ui_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

